generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id               String          @id @default(uuid())
  fullName         String
  email            String          @unique
  phone            String
  passwordHash     String
  role             UserRole
  accountStatus    AccountStatus   @default(pending)
  activationToken  String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdById      String?
  resetToken       String?         @unique
  resetTokenExpiry DateTime?
  lastActiveAt     DateTime?
  pendingEmail     String?
  pendingPhone     String?
  otpCode          String?
  otpExpiry        DateTime?
  otpField         String?

  auditLogs        AuditLog[]
  dispenseEvents   DispenseEvent[]
  prescriptions    Prescription[]  @relation("DoctorPrescriptions")
  createdBy        User?           @relation("AdminCreatedUsers", fields: [createdById], references: [id])
  createdUsers     User[]          @relation("AdminCreatedUsers")

  @@map("users")
}

// ─── PATIENTS ────────────────────────────────────────────────────────────────

model Patient {
  id            String         @id @default(uuid())
  fullName      String
  iin           String
  phone         String
  email         String
  birthDate     DateTime?
  gender        String?
  createdAt     DateTime       @default(now())
  prescriptions Prescription[]

  @@index([iin])
  @@map("patients")
}

// ─── DRUG REFERENCE ──────────────────────────────────────────────────────────

model Drug {
  id             String   @id @default(uuid())
  mnn            String
  tradeName      String?
  atxCode        String
  atxName        String?
  form           String
  routeOfAdmin   String
  dosages        String?
  isPrescription Boolean  @default(true)
  isLgota        Boolean  @default(false)
  minAge         Int?
  maxAge         Int?
  category       String?
  warnings       String?
  createdAt      DateTime @default(now())

  diagnosisLinks DiagnosisDrugLink[]
  interactionsA  DrugInteraction[]   @relation("DrugA")
  interactionsB  DrugInteraction[]   @relation("DrugB")

  @@index([mnn])
  @@index([atxCode])
  @@index([category])
  @@map("drugs")
}

model DiagnosisDrugLink {
  id            String @id @default(uuid())
  diagnosisCode String
  diagnosisName String
  drugId        String
  drug          Drug   @relation(fields: [drugId], references: [id])

  @@index([diagnosisCode])
  @@map("diagnosis_drug_links")
}

model DrugInteraction {
  id          String              @id @default(uuid())
  drugAId     String
  drugBId     String
  severity    InteractionSeverity
  description String
  drugA       Drug                @relation("DrugA", fields: [drugAId], references: [id])
  drugB       Drug                @relation("DrugB", fields: [drugBId], references: [id])

  @@unique([drugAId, drugBId])
  @@map("drug_interactions")
}

// ─── PRESCRIPTIONS ───────────────────────────────────────────────────────────

model Prescription {
  id              String             @id @default(cuid())
  patientId       String
  doctorId        String
  status          PrescriptionStatus @default(created)
  createdAt       DateTime           @default(now())
  expiresAt       DateTime
  cancelledAt     DateTime?
  cancelReason    String?
  diagnosisCode   String?
  diagnosisName   String?
  patientWeight   Float?
  patientAge      Int?
  patientCategory PatientCategory?
  notes           String?

  auditLogs      AuditLog[]
  dispenseEvents DispenseEvent[]
  medications    PrescriptionItem[]
  doctor         User               @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  patient        Patient            @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String         @id @default(uuid())
  prescriptionId String
  name           String
  form           String
  dosage         String
  qtyPrescribed  Int
  qtyDispensed   Int            @default(0)
  course         String
  drugId         String?
  atxCode        String?
  routeOfAdmin   String?
  startDate      DateTime?
  durationDays   Int?
  frequency      String?
  instructions   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  dispenseItems  DispenseItem[]
  prescription   Prescription   @relation(fields: [prescriptionId], references: [id])

  @@map("prescription_items")
}

// ─── DISPENSE ────────────────────────────────────────────────────────────────

model DispenseEvent {
  id             String         @id @default(uuid())
  prescriptionId String
  pharmacistId   String
  timestamp      DateTime       @default(now())
  note           String?
  pharmacist     User           @relation(fields: [pharmacistId], references: [id])
  prescription   Prescription   @relation(fields: [prescriptionId], references: [id])
  items          DispenseItem[]

  @@index([prescriptionId])
  @@map("dispense_events")
}

model DispenseItem {
  id              String           @id @default(uuid())
  dispenseEventId String
  itemId          String
  qtyDispensed    Int
  dispenseEvent   DispenseEvent    @relation(fields: [dispenseEventId], references: [id])
  item            PrescriptionItem @relation(fields: [itemId], references: [id])

  @@map("dispense_items")
}

// ─── AUDIT ───────────────────────────────────────────────────────────────────

model AuditLog {
  id             String        @id @default(uuid())
  userId         String
  action         String
  entityType     String
  entityId       String
  details        String
  timestamp      DateTime      @default(now())
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}


// ─── ICD-10 СПРАВОЧНИК ────────────────────────────────────────────────────────

model ICD10 {
  id            String @id @default(uuid())
  code          String @unique // I10, J18 и т.д.
  name          String // Название на русском
  groupCode     String? // Код группы из MCB-2

  @@index([code])
  @@index([name])
  @@map("icd10")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  doctor
  pharmacist
  admin
  super_admin
}

enum AccountStatus {
  pending
  active
  suspended
}

enum PrescriptionStatus {
  created
  active
  partially_dispensed
  dispensed
  cancelled
  expired
}

enum PatientCategory {
  child
  adult
  elderly
}

enum InteractionSeverity {
  warning
  contraindicated
}
